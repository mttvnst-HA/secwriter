{
  "name": "secwriter",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "parse": "node tools/parse-sec.js",
    "test": "vitest run",
    "test:compliance": "node --import ./tools/json-loader.mjs --test src/lib/__tests__/compliance-rules.node-test.mjs src/lib/__tests__/compliance-rules-pos-window.node-test.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:corpus": "node --import ./tools/json-loader.mjs --test src/lib/__tests__/corpus-calibration.node-test.mjs src/lib/__tests__/corpus-precision.node-test.mjs src/lib/__tests__/corpus-recall.node-test.mjs src/lib/__tests__/corpus-adversarial.node-test.mjs",
    "test:corpus:calibration": "node --test src/lib/__tests__/corpus-calibration.node-test.mjs",
    "test:corpus:precision": "node --test src/lib/__tests__/corpus-precision.node-test.mjs",
    "test:corpus:recall": "node --test src/lib/__tests__/corpus-recall.node-test.mjs",
    "test:corpus:adversarial": "node --test src/lib/__tests__/corpus-adversarial.node-test.mjs",
    "corpus:extract": "node tools/extract-corpus.mjs",
    "corpus:test": "node --import ./tools/json-loader.mjs tools/run-corpus-test.mjs",
    "corpus:report": "node tools/generate-report.mjs",
    "test:interop": "node --import ./tools/json-loader.mjs --test tests/interop.node-test.mjs",
    "test:interop:encoding": "node --import ./tools/json-loader.mjs --test tests/interop-encoding.node-test.mjs",
    "test:ufgs": "node --import ./tools/json-loader.mjs --test tests/ufgs-tag-coverage.node-test.mjs tests/ufgs-structural.node-test.mjs",
    "test:byte-stability": "node --import ./tools/json-loader.mjs --test tests/pmdoc-html-byte-stability.node-test.mjs",
    "audit:init": "node tools/ui-audit/run-audit.mjs",
    "audit:list": "node tools/ui-audit/run-audit.mjs --list",
    "audit:report": "node tools/ui-audit/collect-findings.mjs test-results/findings.json",
    "audit:promote": "node tools/ui-audit/promote-to-github.mjs test-results/findings.json",
    "collab": "node server/collab-server.cjs",
    "test:server": "node --test --test-force-exit server/__tests__/dom-polyfill.test.mjs server/__tests__/storage-local.test.mjs server/__tests__/storage-azure.test.mjs server/__tests__/storage-s3.test.mjs server/__tests__/storage-contract.test.mjs server/__tests__/room-serializer.test.mjs server/__tests__/migrate-pm-substrate.test.mjs server/__tests__/http-endpoints.test.mjs server/__tests__/auth-jwt.test.mjs server/__tests__/collab-server.test.mjs",
    "test:azure:integration": "node --test server/__tests__/storage-azure.integration.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1046.0",
    "@azure/identity": "^4.13.1",
    "@azure/msal-browser": "^5.6.3",
    "@azure/storage-blob": "^12.31.0",
    "compromise": "^14.15.0",
    "harper.js": "^2.0.0",
    "jsonrepair": "^3.14.0",
    "jsonwebtoken": "^9.0.3",
    "linkedom": "^0.18.12",
    "lucide-react": "^1.16.0",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.7",
    "prosemirror-state": "^1.4.4",
    "prosemirror-transform": "^1.12.0",
    "prosemirror-view": "^1.41.8",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "y-websocket": "^1.5.4",
    "yjs": "^13.6.30"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "aws-sdk-client-mock": "^4.1.0",
    "jsdom": "^29.1.0",
    "vite": "^8.0.13",
    "vitest": "^4.1.6",
    "ws": "^8.20.1"
  }
}
