# ── Client (Vite) ─────────────────────────────────────────────
# Azure AD / Entra ID authentication (optional — omit for stub mode)
# VITE_AZURE_AD_CLIENT_ID=
# VITE_AZURE_AD_TENANT_ID=
# VITE_AZURE_AD_REDIRECT_URI=http://localhost:5173

# ── Server (collab-server) ────────────────────────────────────
# Auth provider — must match client Azure AD config
# SIM_AUTH_PROVIDER=jwt
# SIM_AUTH_JWT_SECRET=
# SIM_AUTH_JWT_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# SIM_AUTH_JWT_AUDIENCE=<client-id>

# CORS allowed origin (default: * for dev; restrict in production)
# SIM_COLLAB_ORIGIN=http://localhost:5173

# Storage backend
# SIM_STORAGE_BACKEND=local
# SIM_AZURE_STORAGE_CONNECTION_STRING=
# SIM_AZURE_STORAGE_ACCOUNT_URL=
# SIM_AZURE_STORAGE_CONTAINER=sim-collab-rooms

# S3-compatible storage (Cloudflare R2, AWS S3, MinIO)
# SIM_STORAGE_BACKEND=s3
# SIM_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# SIM_S3_REGION=auto
# SIM_S3_ACCESS_KEY_ID=
# SIM_S3_SECRET_ACCESS_KEY=
# SIM_S3_BUCKET=sim-collab-rooms
