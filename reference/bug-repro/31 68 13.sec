<TTL>Structural Steel</TTL><BRK/>
<TXT><RID>ASTM A36/A36M</RID> [ <RID>ASTM A572/A572M</RID> , Grade <MET>345</MET> <ENG>50</ENG> ] [ <RID>ASTM A588/A588M</RID> ] [ <RID>ASTM A709/A709M</RID> Grade <MET>[248] [345]</MET> <ENG>[36] [50]</ENG> ].</TXT><BRK/>
<BRK/>
</SPT>
<SPT>
<TTL>Steel Pipe</TTL><BRK/>
