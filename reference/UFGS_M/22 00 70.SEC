      <ROW AUTOHEIGHT="0" HEIGHT="47.25">
         <CEL MERGEACROSS="1" STYLEID="s50">
<DTA TYPE="STRING">Storage Capacity or Input Rating of</DTA>
         </CEL>
         <CEL INDEX="3">
<DTA TYPE="STRING">Rating Condition</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="47.25">
         <CEL>
<DTA TYPE="STRING"><MET>189 liters </MET><ENG>50 gallons </ENG>or less</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING"><MET>30765 W</MET> <ENG>105,000 Btu/h</ENG> or less</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING">minimum EF 0.59-0.0019V per <RID>10 CFR 430</RID></DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="72.75">
         <CEL>
<DTA TYPE="STRING">more than <MET>189 liters </MET><ENG>50 gallons </ENG>or less</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING">more than<MET> 30765 W</MET><ENG> 105,000 Btu/h</ENG></DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING">ET 80 percent; maximum SL<MET>  0.2931(Q/800+110 square root of V), W</MET><ENG> Q/800+110 square root of V, Btu/h</ENG> per <RID>ANSI Z21.10.3/CSA 4.3</RID>.</DTA>
         </CEL>
      </ROW>
   </TDA>
</WBK>
<BRL/><BRL/><BRL/><BRL/><BRL/><BRL/><BRL/><BRL/><BRL/><BRL/><BRL/><BRL/><BRL/><BRL/><BRL/></TAB><BRK/></TXT>
<BRK/></SPT>
</SPT><SPT><TTL>Unfired Hot Water Storage</TTL><BRK/>
<BRK/>
<TXT>All volumes and inputs: Provide tank surface thermally insulated to a minimum of R12.5.</TXT><BRK/>
<BRK/></SPT>
<SPT><TTL>Instantaneous Water Heater</TTL><BRK/>
<BRK/>
<SPT><TTL>Gas</TTL><BRK/>
<TXT><TAB>
<WBK>
