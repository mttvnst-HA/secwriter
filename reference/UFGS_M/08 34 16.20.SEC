<DTA TYPE="STRING"><HL4>500</HL4></DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING"><HL4>?</HL4></DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING"><HL4>?</HL4></DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="23.25">
