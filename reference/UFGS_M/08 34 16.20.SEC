         </CEL>
         <CEL>
<DTA TYPE="STRING"><HL4>100</HL4></DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING"><HL4>?</HL4></DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING"><HL4>?</HL4></DTA>
         </CEL>
      </ROW>
