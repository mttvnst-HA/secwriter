         <CEL>
<DTA TYPE="STRING"><HL4>?</HL4></DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING"><HL4>200</HL4></DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING"><HL4>?</HL4></DTA>
