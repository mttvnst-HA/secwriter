   </TDA>
</WBK>
<BRL/><BRL/><BRL/><BRL/><BRL/><BRL/><BRL/><BRL/><BRL/><BRL/><BRL/><BRL/><BRL/><BRL/><BRL/><BRL/><BRL/><BRL/></TAB><BRK/>
<NPR>Or similar, adjust these for project:</NPR><BRK/>
<TAB WIDTH="87">
<WBK>
   <STS/>
   <TDA COLUMNCOUNT="5" ROWCOUNT="9">
      <COL AUTOWIDTH="0" WIDTH="167.25"/>
      <COL AUTOWIDTH="0" WIDTH="80.25"/>
      <COL AUTOWIDTH="0" WIDTH="80.25"/>
      <COL AUTOWIDTH="0" WIDTH="80.25"/>
      <COL AUTOWIDTH="0" WIDTH="80.25"/>
      <ROW AUTOHEIGHT="0" HEIGHT="60.00">
         <CEL>
<DTA TYPE="STRING">Features</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING"><HL4>Initial<BRK/>Peak<BRK/>Particle<BRK/>Velocity<BRK/>(ips)</HL4></DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING"><HL4>Initial<BRK/>Peak<BRK/>Particle<BRK/>Velocity<BRK/>(cps)</HL4></DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING"><HL4>Production<BRK/>Particle<BRK/>Velocity,<BRK/>ips</HL4></DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING"><HL4>Production<BRK/>Particle<BRK/>Velocity,<BRK/>cps</HL4></DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="15.00">
         <CEL>
<DTA TYPE="STRING">Lock Control Room</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING"><HL4>0.5</HL4></DTA>
