      <COL STYLEID="s50" AUTOWIDTH="0" WIDTH="292.50"/>
      <ROW AUTOHEIGHT="0" HEIGHT="24.00">
         <CEL STYLEID="s51">
<DTA TYPE="STRING">Time from mix (minimum)</DTA>
