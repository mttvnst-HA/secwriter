         <CEL>
<DTA TYPE="STRING">0 to 120 seconds</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING">15 seconds</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="26.25">
