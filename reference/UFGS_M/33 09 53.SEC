<DTA TYPE="STRING">Return flow to initiate lead pump shutdown sequence</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING"><MET>30 to 50 L/s</MET><ENG>500 to 800 gpm</ENG></DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING"><MET>35 L/s</MET><ENG>560 gpm</ENG></DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="29.25">
         <CEL>
<DTA TYPE="STRING">Timer to enable start-up of lead pump</DTA>
