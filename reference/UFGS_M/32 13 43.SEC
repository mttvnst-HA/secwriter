<DTA TYPE="STRING">7</DTA>
         </CEL>
         <CEL STYLEID="s52">
<DTA TYPE="STRING">16</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="29.25">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Slag Cement</DTA>
         </CEL>
