         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="15.75">
         <CEL STYLEID="s51">
<DTA TYPE="STRING"><MET> 50 mm</MET><ENG> 2 inch</ENG></DTA>
         </CEL>
         <CEL STYLEID="s51">
<DTA TYPE="STRING"><MET> 16 mm</MET><ENG> 5/8 inch</ENG></DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="15.75">
         <CEL STYLEID="s51">
<DTA TYPE="STRING"><MET> 65 mm</MET><ENG> 2.5 inch</ENG></DTA>
         </CEL>
         <CEL STYLEID="s51">
