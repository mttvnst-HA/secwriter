<DTA TYPE="STRING">Mean Temp (degrees<MET> C</MET><ENG> F</ENG>)</DTA>
         </CEL>
         <CEL STYLEID="s51">
<DTA TYPE="STRING">k</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="20.25">
