<DTA TYPE="STRING"><MET>93 </MET><ENG>200</ENG></DTA>
         </CEL>
         <CEL STYLEID="s51">
<DTA TYPE="STRING"><MET>0.04 </MET><ENG>0.41</ENG></DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="20.25">
