<DTA TYPE="STRING">Type of pump:</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING">[Packed plunger][Packed piston][Mechanically or hydraulically coupled diaphragm].</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="24.00">
