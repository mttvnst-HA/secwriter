         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING"><HL1>Inch-Pound</HL1></DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING"><HL1>Metric</HL1></DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="24.00">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Boilers</DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Capacity-18,000 #/hr</DTA>
         </CEL>
