         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING"><MET>5 deg C</MET><ENG>41 deg F</ENG>, minimum</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="22.50">
