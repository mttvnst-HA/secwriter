<DTA TYPE="STRING">Gilsonite Modified Asphalt Emulsion<BRK/><MET> l/m2</MET><ENG> gal/yd2</ENG></DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING"><TAI OPT="WITH AGGREGATE">Quantity of Aggregate<BRK/><MET> kg/m2</MET><ENG> lbs/yd2</ENG></TAI></DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="39.75">
