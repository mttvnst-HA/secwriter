<DTA TYPE="STRING">= 6 inches</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING">= 150 mm</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="24.00">
         <CEL>
<DTA TYPE="STRING">b.  Stack Thermometer Scale Range</DTA>
         </CEL>
