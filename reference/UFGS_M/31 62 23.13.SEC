      <COL AUTOWIDTH="0" WIDTH="81.75"/>
      <COL AUTOWIDTH="0" WIDTH="203.25"/>
      <ROW AUTOHEIGHT="0" HEIGHT="24.00">
         <CEL STYLEID="s50">
