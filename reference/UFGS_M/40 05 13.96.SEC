      <ROW AUTOHEIGHT="0" HEIGHT="24.00">
         <CEL MERGEACROSS="3">
<DTA TYPE="STRING">(1) All welds must be given a visual examination in addition to type of specific nondestructive examination specified.</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="24.00">
