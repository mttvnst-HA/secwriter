<DTA TYPE="STRING">Water Absorption (<RID>ASTM D570</RID>)</DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Nil</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="35.25">
