<DTA TYPE="STRING">Impact Strength (<RID>ASTM D256</RID>)</DTA>
         </CEL>
         <CEL STYLEID="s50"/>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="36.00">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">    Test Method A, Izod</DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Non-break for all five determinations in sample</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="24.00">
