<DTA TYPE="STRING">Hardness (<RID>ASTM D2240</RID>), minimum</DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Shore D 65</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="24.00">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Coefficient of Friction (<RID>ASTM D1894</RID>)</DTA>
         </CEL>
         <CEL STYLEID="s50"/>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="24.00">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">    Kinetic, maximum</DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">0.13</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="24.00">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">    Static, maximum</DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">0.20</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="24.00">
