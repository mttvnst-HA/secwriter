<BRK/>
<ITM><SUB>As-Built Drawings</SUB>; <SUB>G<TAI OPT="ARMY">, [_____]</TAI></SUB></ITM><BRK/>
<BRK/>
<ITM><SUB>Piping Layout</SUB>; <SUB>G<TAI OPT="ARMY">, [_____]</TAI></SUB></ITM><BRK/>
<BRK/>
<ITM><SUB>Pump Room</SUB>; <SUB>G<TAI OPT="ARMY">, [_____]</TAI></SUB></ITM><BRK/>
<BRK/>
<LST><SUB>SD-03 Product Data</SUB></LST><BRK/>
<BRK/>
<ITM><SUB>Catalog Data</SUB>; <SUB>G<TAI OPT="ARMY">, [_____]</TAI></SUB></ITM><BRK/>
<BRK/>
<ITM><SUB>Spare Parts</SUB></ITM><BRK/>
<BRK/>
<ITM><SUB>Preliminary Tests</SUB></ITM><BRK/>
<BRK/>
<ITM>  At least [14] [_____] days prior to the proposed date and time to begin Preliminary Tests</ITM><BRK/>
<BRK/>
<ITM><SUB>Field Tests</SUB>; <SUB>G<TAI OPT="ARMY">, [_____]</TAI></SUB></ITM><BRK/>
<BRK/>
<ITM>  At least 2 weeks before starting field tests</ITM><BRK/>
<BRK/>
<ITM><SUB>Manufacturer's Representative</SUB>; <SUB>G<TAI OPT="ARMY">, [_____]</TAI></SUB></ITM><BRK/>
<BRK/>
