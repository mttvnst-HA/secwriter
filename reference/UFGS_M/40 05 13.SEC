      <ROW AUTOHEIGHT="0" HEIGHT="24.00">
         <CEL MERGEACROSS="17" STYLEID="s50">
<DTA TYPE="STRING">TABLE I<BRK/>PIPE AND FITTING MATERIALS FOR COMMON PIPING SYSTEMS</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="24.00">
         <CEL MERGEDOWN="1">
<DTA TYPE="STRING">Item No.</DTA>
         </CEL>
