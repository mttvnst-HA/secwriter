<DTA TYPE="STRING">Pipe Material</DTA>
         </CEL>
         <CEL MERGEACROSS="15" STYLEID="s50">
<DTA TYPE="STRING">SERVICE</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="24.00">
         <CEL INDEX="3" STYLEID="s50">
<DTA TYPE="STRING">A</DTA>
