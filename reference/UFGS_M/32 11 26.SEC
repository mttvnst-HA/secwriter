         <CEL STYLEID="s51">
<DTA TYPE="STRING">Design ESALs (millions)</DTA>
         </CEL>
         <CEL STYLEID="s51">
<DTA TYPE="STRING">Typical Roadway Application</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="27.00">
