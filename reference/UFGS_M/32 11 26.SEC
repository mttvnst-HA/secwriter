<DTA TYPE="STRING">Attribute</DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Measurement</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="23.25">
         <CEL MERGEACROSS="1" STYLEID="s50">
<DTA TYPE="STRING">Plant Mixture</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="23.25">
         <CEL>
<DTA TYPE="STRING">Delivery to Laydown Machine</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING">Minimum<MET> 121 deg C</MET><ENG> 250 deg F</ENG></DTA>
         </CEL>
      </ROW>
