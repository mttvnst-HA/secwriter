<DTA TYPE="STRING"><HL1>English Units</HL1></DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING"><HL1>Metric Units</HL1></DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="24.00">
