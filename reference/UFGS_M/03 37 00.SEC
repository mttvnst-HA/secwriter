<DTA TYPE="STRING">[_____]</DTA>
         </CEL>
         <CEL STYLEID="s51">
<DTA TYPE="STRING"><RID>ASTM C127</RID><BRK/><RID>ASTM C128</RID></DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="39.00">
