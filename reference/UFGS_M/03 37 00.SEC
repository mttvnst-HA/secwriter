         </CEL>
         <CEL STYLEID="s51">
<DTA TYPE="STRING"><RID>COE CRD-C 114</RID><BRK/><RID>ASTM C666/C666M</RID></DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="39.00">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Clay Lump and Friable Particles</DTA>
         </CEL>
         <CEL STYLEID="s52">
<DTA TYPE="STRING">[_____]</DTA>
         </CEL>
