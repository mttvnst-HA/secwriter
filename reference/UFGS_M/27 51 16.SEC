      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="22.50">
         <CEL INDEX="2" STYLEID="s50">
<DTA TYPE="STRING">Peak   - [10] [_____] watts</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="22.50">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Voice Coil Impedance</DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">8 ohms</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="22.50">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Line Matching Transformer Type</DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">25/ 70.7 volt line</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="22.50">
