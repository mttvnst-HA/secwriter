         </CEL>
         <CEL>
<DTA TYPE="STRING">0.25 volts into 10,000 ohms</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="23.25">
         <CEL INDEX="2">
<DTA TYPE="STRING">1.0 volts into 10,000 ohms</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="23.25">
         <CEL>
<DTA TYPE="STRING">Frequency Response</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING">Plus or Minus 2 dB, 20 - 20,000 Hz</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="23.25">
         <CEL>
<DTA TYPE="STRING">Distortion</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING">Less than 0.5 percent 20 - 20,000 Hz</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="23.25">
         <CEL>
<DTA TYPE="STRING">Inputs</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING">4 transformer - coupled balanced 150 ohm</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="23.25">
         <CEL>
<DTA TYPE="STRING">Input Sensitivity</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING">0.003 volts</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="27.75">
         <CEL>
<DTA TYPE="STRING">Input Channel Isolation</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING">70 dB minimum</DTA>
         </CEL>
      </ROW>
   </TDA>
</WBK>
<BRL/><BRL/><BRL/><BRL/><BRL/><BRL/><BRL/><BRL/><BRL/><BRL/><BRL/><BRL/><BRL/><BRL/><BRL/></TAB></TXT><BRK/>
<BRK/></SPT>
<SPT><TTL>MICROPHONES<BRK/>
<BRK/></TTL>
<SPT><TTL>Desk Microphone</TTL><BRK/>
<BRK/>
