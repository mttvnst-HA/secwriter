<DTA TYPE="STRING">TABLE 7</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="23.25">
         <CEL MERGEACROSS="1" STYLEID="s50">
<DTA TYPE="STRING">Spall Repairs</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="23.25">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Volume of Prepared Cavity After Removal Operations</DTA>
         </CEL>
