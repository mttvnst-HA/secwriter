         <CEL MERGEACROSS="1" STYLEID="s50">
<DTA TYPE="STRING">LIMITS OF DELETERIOUS MATERIALS IN FINE AGGREGATE</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="17.25">
