         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="17.25">
         <CEL>
<DTA TYPE="STRING">Clay lumps and friable particles <RID>ASTM C142/C142M</RID></DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">1.0</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="17.25">
         <CEL>
<DTA TYPE="STRING">Material finer than<MET> 0.075 mm</MET><ENG> No. 200 sieve</ENG> <RID>ASTM C117</RID></DTA>
         </CEL>
         <CEL STYLEID="s50">
