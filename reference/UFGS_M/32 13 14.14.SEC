<DTA TYPE="STRING">Material</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="23.25">
         <CEL>
<DTA TYPE="STRING">less than<MET> 0.00085 cubic meter</MET><ENG> 0.03 cubic foot</ENG></DTA>
         </CEL>
