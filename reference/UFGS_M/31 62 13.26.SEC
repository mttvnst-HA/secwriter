         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING"><HL4>55-80</HL4></DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING"><HL4>20-45</HL4></DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="24.00">
         <CEL STYLEID="s50">
<DTA TYPE="STRING"><HL4><MET>0.300 mm</MET> <ENG>50</ENG></HL4></DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING"><HL4>30-55</HL4></DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING"><HL4>45-70</HL4></DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="24.00">
         <CEL STYLEID="s50">
<DTA TYPE="STRING"><HL4><MET>0.150 mm</MET> <ENG>100 </ENG></HL4></DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING"><HL4>10-30</HL4></DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING"><HL4>70-90</HL4></DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="23.25">
         <CEL STYLEID="s50">
<DTA TYPE="STRING"><HL4><MET>0.075 mm</MET> <ENG>200</ENG></HL4></DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING"><HL4>0-10</HL4></DTA>
