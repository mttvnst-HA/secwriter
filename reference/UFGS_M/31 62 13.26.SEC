         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="24.00">
         <CEL STYLEID="s50">
<DTA TYPE="STRING"><HL4><MET>2.38 mm</MET> <ENG>8</ENG></HL4></DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING"><HL4>100</HL4></DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING"><HL4>0</HL4></DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="24.00">
