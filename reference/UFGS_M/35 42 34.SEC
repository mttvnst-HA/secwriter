<DTA TYPE="STRING">One test per structure per 2,000 sq. ft taken 12 inches below finished grade.</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="24.00">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Subgrades</DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Site (except airfields)</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING">One test per lift per 2,500 sq. ft</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="24.00">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Embankments or borrow</DTA>
         </CEL>
