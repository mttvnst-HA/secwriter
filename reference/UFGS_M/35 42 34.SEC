<DTA TYPE="STRING">One test or one test per 10,000 sq. ft whichever is greater.</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="23.25">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Borrow</DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Any</DTA>
