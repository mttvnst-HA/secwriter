         <CEL>
<DTA TYPE="STRING">One test per lift per 500 cubic yds placed.</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="60.00">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Native soil subgrade other than structures and parking</DTA>
         </CEL>
