<ENG><TAB WIDTH="94">
<WBK>
   <STS>
      <STY SID="s50">
         <ALN VERTICAL="BOTTOM"/>
      </STY>
   </STS>
   <TDA COLUMNCOUNT="3" ROWCOUNT="7">
      <COL STYLEID="s50" AUTOWIDTH="0" WIDTH="120.00"/>
      <COL STYLEID="s50" AUTOWIDTH="0" WIDTH="120.00"/>
      <COL AUTOWIDTH="0" WIDTH="288.75"/>
      <ROW AUTOHEIGHT="0" HEIGHT="24.00">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Material Type</DTA>
         </CEL>
