         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING"><MET>[800][_____] cubic meters</MET><ENG>[1,000][_____] cubic yards</ENG></DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING"><RID>ASTM D4318</RID></DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="47.25">
         <CEL>
<DTA TYPE="STRING">Plasticity Index<BRK/>(Note 1)</DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING"><MET>[800][_____] cubic meters</MET><ENG>[1,000][_____] cubic yards</ENG></DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING"><RID>ASTM D4318</RID></DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="42.75">
