<DTA TYPE="STRING"><MET>[5,000][_____] cubic meters</MET><ENG>[6,500][_____] cubic yards</ENG></DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING"><RID>ASTM D698</RID><BRK/><RID>ASTM D1557</RID><BRK/></DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="62.25">
         <CEL MERGEACROSS="2">
<DTA TYPE="STRING">Note 1: Perform at least one test each day that soil is placed.<BRK/>Note 2: Compare compaction test results to previous results on the same material type to verify the compaction characteristics have remained the same.<BRK/></DTA>
         </CEL>
