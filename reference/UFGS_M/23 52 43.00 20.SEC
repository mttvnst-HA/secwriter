         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="24.00">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">a.  Alarm Bell Diameter</DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">= 4 inches</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING">= 100 mm</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="23.25">
