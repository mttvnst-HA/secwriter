         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">[_____]<MET> square mm</MET><ENG> square inches</ENG></DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING"><RID>ASTM D3916</RID> (round)<BRK/><RID>ASTM D3039/D3039M</RID> (rectangular)</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="23.25">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Fiber Volume Fraction</DTA>
         </CEL>
         <CEL STYLEID="s50">
