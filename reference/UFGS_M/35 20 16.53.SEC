         <CEL>
<DTA TYPE="STRING"><MET>6.9 MPa</MET><ENG>1,000 psi</ENG> (min.)</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING"><RID>ASTM D412</RID></DTA>
         </CEL>
      </ROW>
