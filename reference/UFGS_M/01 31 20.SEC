<ITM><SUB>Digital Photographs</SUB>; <SUB>G<TAI OPT="ARMY">, [_____]</TAI></SUB></ITM><BRK/>
<BRK/>
<ITM><SUB>Database Files</SUB>; <SUB>G<TAI OPT="ARMY">, [_____]</TAI></SUB></ITM><BRK/>
<BRK/>
<TAI OPT="CAD 3D MODEL"><ITM><SUB>Digital 3D CAD Model Files</SUB>; <SUB>G<TAI OPT="ARMY">, [_____]</TAI></SUB></ITM></TAI><BRK/>
<BRK/>
<LST><SUB>SD-07 Certificates</SUB></LST><BRK/>
<BRK/>
<ITM><SUB>Data Manager</SUB>; <SUB>G<TAI OPT="ARMY">, [_____]</TAI></SUB></ITM><BRK/>
