<BRK/>
 <TAI OPT="OPENGROUND"><ITM><SUB>Finalized OpenGround Cloud Borehole Database</SUB>; <SUB>G<TAI OPT="ARMY">, [_____]</TAI></SUB></ITM></TAI><BRK/>
<BRK/>
<ITM><SUB>Final File Indexes</SUB>; <SUB>G<TAI OPT="ARMY">, [_____]</TAI></SUB></ITM><BRK/>
<BRK/>
