<DTA TYPE="STRING">Steel Plates, Structural</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING"><RID>ASTM A285/A285M</RID>, Grade B</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="11.25">
         <CEL>
<DTA TYPE="STRING">Steel Plates, Pressure Vessel</DTA>
         </CEL>
