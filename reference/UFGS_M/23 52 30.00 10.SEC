<DTA TYPE="STRING">Tank Outlet Capacity (operating)</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING">[_____]<MET> kg</MET><ENG> lb</ENG> per hour</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="23.25">
         <CEL>
<DTA TYPE="STRING">Tank Outlet Capacity (design)</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING">[_____]<MET> kg</MET><ENG> lb</ENG> per hour</DTA>
