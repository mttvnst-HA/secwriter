<DTA TYPE="STRING">PSL-[_____]</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING">Pressure-low feedwater</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="23.25">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">PSH-[_____]</DTA>
         </CEL>
