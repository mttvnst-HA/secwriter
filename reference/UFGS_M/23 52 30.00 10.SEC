<DTA TYPE="STRING">Makeup steam - Operating</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING">[_____]<MET> kg/hour kPa (2.79 MJ/kg)</MET><ENG> lb/hour psig (1200 Btu/lb)</ENG></DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="23.25">
         <CEL>
<DTA TYPE="STRING">Makeup steam - Design</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING">[_____]<MET> kg/hour kPa (2.79 MJ/kg)</MET><ENG> lb/hour psig (1200 Btu/lb)</ENG></DTA>
