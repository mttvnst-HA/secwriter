<BRK/>
<TAI OPT="LEED"><ITM><SUB>Cementitious Materials</SUB>; <SUB>G<TAI OPT="ARMY">, [_____]</TAI></SUB></ITM><BRK/>
<BRK/></TAI>
<TAI OPT="LEED">[<ITM><SUB>Albedo</SUB></ITM><BRK/>
<BRK/>
]</TAI><ITM><SUB>Dowel Bars</SUB></ITM><BRK/>
<BRK/>
<ITM><SUB>Expansion Joint Filler</SUB></ITM><BRK/>
<BRK/>
<LST><SUB>SD-04 Samples</SUB></LST><BRK/>
<BRK/>
<ITM><SUB>Test Section</SUB>; <SUB>G<TAI OPT="ARMY">, [_____]</TAI></SUB></ITM><BRK/>
<BRK/>
<LST><SUB>SD-05 Design Data</SUB></LST><BRK/>
<BRK/>
<ITM><SUB>Mix Design Report</SUB>; <SUB>G<TAI OPT="ARMY">, [_____]</TAI></SUB></ITM><BRK/>
<BRK/>
