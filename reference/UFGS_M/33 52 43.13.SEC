         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="15.00">
         <CEL STYLEID="s50">
<DTA TYPE="STRING"><MET>100 mm</MET><ENG>4 inch</ENG></DTA>
         </CEL>
         <CEL STYLEID="s50">
