         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="15.00">
         <CEL STYLEID="s50">
<DTA TYPE="STRING"><MET>150 mm</MET><ENG>6 inch</ENG></DTA>
