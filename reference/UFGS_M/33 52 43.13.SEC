         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="15.00">
         <CEL STYLEID="s50">
<DTA TYPE="STRING"><MET>203 mm</MET><ENG>8 inch</ENG></DTA>
