         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="21.00">
         <CEL STYLEID="s50">
<DTA TYPE="STRING"><MET>355 mm</MET><ENG>14 inch</ENG></DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING"><MET>25 mm</MET><ENG>  1  inch</ENG></DTA>
         </CEL>
      </ROW>
