         <CEL STYLEID="s50">
<DTA TYPE="STRING">Measurement</DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Tolerance</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="23.25">
         <CEL>
<DTA TYPE="STRING">Grade</DTA>
         </CEL>
         <CEL STYLEID="s51">
<DTA TYPE="STRING">Plus <MET>6 mm</MET><ENG> 1/4 inch</ENG>, Minus<MET> 13 mm</MET><ENG> 1/2 inch</ENG></DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="23.25">
         <CEL>
<DTA TYPE="STRING">Smoothness</DTA>
         </CEL>
         <CEL STYLEID="s50">
