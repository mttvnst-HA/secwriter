      <ROW AUTOHEIGHT="0" HEIGHT="24.00">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">2.5H:1V to 3H:1V</DTA>
         </CEL>
         <CEL STYLEID="s50">
