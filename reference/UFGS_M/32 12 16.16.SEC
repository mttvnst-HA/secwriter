<DTA TYPE="STRING"><TAI OPT="PERCENT PAYMENT">92.0 - 96.0</TAI><TAI OPT="ACCEPT-REJECT"> 93.0 minimum</TAI></DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="24.75">
         <CEL>
<DTA TYPE="STRING">Joint Density, Percent of TMD (Average of 4 Random Cores)</DTA>
