<DTA TYPE="STRING"><MET>0.15 and 0.075 mm</MET><ENG>No. 100 and No. 200</ENG></DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">JMF plus or minus 2.0</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="32.25">
