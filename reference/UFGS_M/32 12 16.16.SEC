<DTA TYPE="STRING"><MET>2.36, 1.18, 0.60, and 0.30 mm</MET><ENG>No. 8, No. 16, No. 30, and No. 50</ENG></DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">JMF plus or minus 6</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="23.25">
