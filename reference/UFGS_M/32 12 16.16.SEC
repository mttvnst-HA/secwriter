<DTA TYPE="STRING"><TAI OPT="PERCENT PAYMENT">89.5 minimum</TAI><TAI OPT="ACCEPT-REJECT"> 90.0 minimum</TAI></DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="42.00">
         <CEL>
<DTA TYPE="STRING">Stability,<MET> newtons</MET><ENG> pounds</ENG> (Average of 3 specimens)<BRK/>(for Marshall only)</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING">[<MET>4450 </MET><ENG>1000 </ENG>minimum for 50 blows][<MET>8000 </MET><ENG>1800 </ENG>minimum for 75 blows]</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="74.25">
         <CEL>
<DTA TYPE="STRING">Flow,<MET> 0.25 mm</MET><ENG> 0.01 inch</ENG> (Average of 3 specimens)<BRK/>(for Marshall only with non-modified asphalt)</DTA>
         </CEL>
