         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">5-15</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="23.25">
         <CEL>
<DTA TYPE="STRING"><MET> 0.15 mm</MET><ENG> No. 100</ENG></DTA>
         </CEL>
         <CEL STYLEID="s50">
