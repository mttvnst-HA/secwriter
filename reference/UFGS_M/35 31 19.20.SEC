<DTA TYPE="STRING">Puncture Strength,<MET> N</MET><ENG> lbs.</ENG></DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">[<MET>250 </MET><ENG>55 </ENG>nonwoven]</DTA>
         </CEL>
         <CEL MERGEDOWN="1">
<DTA TYPE="STRING"><RID>ASTM D4833/D4833M</RID></DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="24.00">
         <CEL INDEX="2" STYLEID="s50">
<DTA TYPE="STRING">[<MET>400 </MET><ENG>90 </ENG>woven]</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="24.00">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Permittivity, 1/sec</DTA>
         </CEL>
