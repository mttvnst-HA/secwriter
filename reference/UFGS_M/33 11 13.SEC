      </ROW>
      <ROW>
         <CEL>
<DTA TYPE="STRING">Color</DTA>
         </CEL>
         <CEL/>
      </ROW>
      <ROW>
         <CEL>
<DTA TYPE="STRING">Taste</DTA>
         </CEL>
         <CEL/>
      </ROW>
      <ROW>
         <CEL>
<DTA TYPE="STRING">Threshold odor number</DTA>
