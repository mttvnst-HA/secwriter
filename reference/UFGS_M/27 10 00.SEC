<DTA TYPE="STRING">1</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="19.50">
         <CEL STYLEID="s50">
<DTA TYPE="STRING"><MET>13 - 16 </MET><ENG>42 - 52</ENG></DTA>
         </CEL>
