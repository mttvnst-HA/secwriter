      <STY SID="s50">
         <ALN VERTICAL="BOTTOM"/>
      </STY>
      <STY SID="s51">
         <ALN HORIZONTAL="CENTER" VERTICAL="BOTTOM"/>
      </STY>
   </STS>
   <TDA COLUMNCOUNT="2" ROWCOUNT="6">
      <COL STYLEID="s50" AUTOWIDTH="0" WIDTH="150.00"/>
      <COL STYLEID="s50" AUTOWIDTH="0" WIDTH="300.00"/>
      <ROW AUTOHEIGHT="0" HEIGHT="24.00">
         <CEL STYLEID="s51">
<DTA TYPE="STRING">Subgrade Classification</DTA>
         </CEL>
         <CEL STYLEID="s51">
<DTA TYPE="STRING">Emulsion Type<BRK/><BRK/></DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="24.00">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">GP</DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">MS-1, HFMS-1, MS-2h, HFMS-2h, CMS-2, CMS-2h</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="24.00">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">GW</DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">MS-2h, HFMS-2h, HFMS-2s, SS-1, SS-1h, CSS-1, CSS-1h</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="24.00">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">SW, SP</DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">MS-2h, HFMS-2h, HFMS-2s, SS-1, SS-1h, CSS-1, CSS-1h</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="24.00">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">GM, SM</DTA>
         </CEL>
         <CEL STYLEID="s50">
