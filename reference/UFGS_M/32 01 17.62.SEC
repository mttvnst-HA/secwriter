<DTA TYPE="STRING">Maximum<MET> 150 mm</MET><ENG> 6 inches</ENG></DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="23.25">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Paving Fabric Wrinkles</DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Maximum<MET> 25 mm</MET><ENG> 1 inch</ENG></DTA>
         </CEL>
      </ROW>
