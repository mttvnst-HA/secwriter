<DTA TYPE="STRING">Asphalt Binder Application Temperature</DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Within specified range</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="24.00">
