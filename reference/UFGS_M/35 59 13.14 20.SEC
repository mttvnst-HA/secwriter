<DTA TYPE="STRING">[_____]</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING"><MET>kNm </MET><ENG>kip-ft</ENG></DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING"><RID>ASTM D7258</RID></DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="36.00">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Allowable Axial Capacity  - Short Column<BRK/><BRK/></DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">[_____]<BRK/></DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING"><MET>kg </MET><ENG>kip</ENG></DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING"><RID>ASTM D7258</RID></DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="33.00">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Flexural Rigidity (EI)<BRK/></DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">[_____]<BRK/></DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING"><MET>kg-mm<SPS>2</SPS> </MET><ENG>lb-in<SPS>2</SPS></ENG></DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING"><RID>ASTM D6109</RID>, +/- 10 percent</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="30.75">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Allowable Shear Capacity</DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">[_____]</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING"><MET>kg </MET><ENG>kip</ENG></DTA>
