<DTA TYPE="STRING">Structural Outer Dimension/Diameter<BRK/></DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">[_____]<BRK/></DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING"><MET>mm </MET><ENG>in.</ENG></DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING">N/A, +/- 10 percent</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="24.75">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Allowable Moment Capacity<BRK/></DTA>
         </CEL>
