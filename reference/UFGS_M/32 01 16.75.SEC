<DTA TYPE="STRING">Viscosity at<MET> 60 degrees C, sq mm/sec</MET><ENG> 140 degrees F, 80-500 centistokes</ENG> (2)</DTA>
         </CEL>
         <CEL STYLEID="s51">
<DTA TYPE="STRING">80-500</DTA>
         </CEL>
         <CEL STYLEID="s52">
<DTA TYPE="STRING"><RID>ASTM D2170/D2170M</RID></DTA>
         </CEL>
      </ROW>
