<DTA TYPE="STRING">Density (<RID>ASTM D792</RID>)</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING"><MET>0.92-0.94 g/cc</MET><ENG> 57.5-58.7 lb/cu.ft</ENG></DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="24.00">
