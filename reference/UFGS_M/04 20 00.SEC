         </CEL>
         <CEL STYLEID="s52">
<DTA TYPE="STRING">-</DTA>
         </CEL>
         <CEL STYLEID="s52">
<DTA TYPE="STRING">HE</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="48.00">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Low heat of hydration</DTA>
         </CEL>
         <CEL STYLEID="s51">
<DTA TYPE="STRING">IV</DTA>
         </CEL>
         <CEL STYLEID="s52">
<DTA TYPE="STRING">IL(LH)<BRK/>IS(&lt;70)(LH)<BRK/>IP(LH)<BRK/>IT(S&lt;70)(LH)<BRK/></DTA>
         </CEL>
