         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="36.00">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Maximum Horizontal Spacing</DTA>
         </CEL>
         <CEL STYLEID="s51">
<DTA TYPE="STRING"><MET>406 mm</MET><ENG>16 inch</ENG></DTA>
         </CEL>
         <CEL STYLEID="s52">
<DTA TYPE="STRING"><MET>914 mm</MET><ENG>36 inch</ENG></DTA>
         </CEL>
         <CEL STYLEID="s52">
<DTA TYPE="STRING"><MET>914 mm</MET><ENG>36 inch</ENG></DTA>
         </CEL>
         <CEL STYLEID="s52">
<DTA TYPE="STRING"><MET>406 mm</MET><ENG>16 inch</ENG></DTA>
         </CEL>
         <CEL STYLEID="s52"/>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="47.25">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Maximum Vertical Spacing</DTA>
         </CEL>
         <CEL STYLEID="s51">
<DTA TYPE="STRING"><MET>406 mm</MET><ENG>16 inch</ENG></DTA>
         </CEL>
         <CEL STYLEID="s52">
<DTA TYPE="STRING"><MET>610 mm</MET><ENG>24 inch</ENG></DTA>
         </CEL>
         <CEL STYLEID="s52">
<DTA TYPE="STRING"><MET>610 mm</MET><ENG>24 inch</ENG></DTA>
         </CEL>
         <CEL STYLEID="s52">
<DTA TYPE="STRING"><MET>610 mm</MET><ENG>24 inch</ENG></DTA>
