         <CEL STYLEID="s51">
<DTA TYPE="STRING"><MET>0.16 m<SPS>2</SPS></MET><ENG>1.77 ft<SPS>2</SPS></ENG><BRK/></DTA>
         </CEL>
         <CEL STYLEID="s52">
<DTA TYPE="STRING"><MET>0.25 m<SPS>2</SPS></MET><ENG>2.67 ft<SPS>2</SPS></ENG><BRK/></DTA>
         </CEL>
         <CEL STYLEID="s52">
<DTA TYPE="STRING"><MET>0.42 m<SPS>2</SPS></MET><ENG>4.50 ft<SPS>2</SPS></ENG><BRK/></DTA>
         </CEL>
         <CEL STYLEID="s52">
<DTA TYPE="STRING">Same as non-adjustable unit ties of same wire size</DTA>
         </CEL>
         <CEL STYLEID="s52">
