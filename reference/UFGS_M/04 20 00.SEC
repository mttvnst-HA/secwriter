         </CEL>
         <CEL STYLEID="s52">
<DTA TYPE="STRING">IL(MH)<BRK/>IS(&lt;70)(MH)<BRK/>IP(MH)<BRK/>IT(S&lt;70)(MH)<BRK/></DTA>
         </CEL>
         <CEL STYLEID="s52">
<DTA TYPE="STRING">MH</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="24.00">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">High early strength</DTA>
         </CEL>
         <CEL STYLEID="s51">
