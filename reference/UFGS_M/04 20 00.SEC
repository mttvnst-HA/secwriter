         </CEL>
         <CEL STYLEID="s52">
<DTA TYPE="STRING">-</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="36.00">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">ASTM C1157 hydraulic cements</DTA>
         </CEL>
         <CEL STYLEID="s51">
<DTA TYPE="STRING">GU</DTA>
         </CEL>
         <CEL STYLEID="s52">
<DTA TYPE="STRING">HE</DTA>
         </CEL>
         <CEL STYLEID="s52">
<DTA TYPE="STRING">MS</DTA>
         </CEL>
         <CEL STYLEID="s52">
