<DTA TYPE="STRING">ASTM C150 portland cements</DTA>
         </CEL>
         <CEL STYLEID="s52">
<DTA TYPE="STRING">ASTM C595 blended hydraulic cements<SPS>*</SPS></DTA>
         </CEL>
         <CEL STYLEID="s52">
<DTA TYPE="STRING">ASTM C595 blended hydraulic cements<SPS>*</SPS></DTA>
         </CEL>
      </ROW>
