<DTA TYPE="STRING">I</DTA>
         </CEL>
         <CEL STYLEID="s52">
<DTA TYPE="STRING">IL<BRK/>IS(&lt;70)<BRK/>IP<BRK/>IT(S&lt;70)</DTA>
         </CEL>
         <CEL STYLEID="s52">
<DTA TYPE="STRING">GU</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="48.00">
