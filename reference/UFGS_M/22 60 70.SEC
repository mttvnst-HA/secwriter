         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Yellow and White Checkerboard/Black</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="24.00">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Laboratory Vacuum</DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Yellow and White Checkerboard/Black Boxed</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="24.00">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Nitrogen</DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Black/White</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="24.00">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Nitrous Oxide</DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Blue/White</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="24.00">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Oral Evacuation</DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">White and Black Checkerboard/Black Boxed</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="21.00">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Oxygen</DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Green/White or White/Green</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="24.00">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Medical Surgical Vacuum</DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">White/Black</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="26.25">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Waste Anesthetic Gas Disposal</DTA>
         </CEL>
