         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="24.00">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Carbon Dioxide</DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Gray/Black or Gray/White</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="24.00">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Instrument Air</DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Red/White</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="24.00">
