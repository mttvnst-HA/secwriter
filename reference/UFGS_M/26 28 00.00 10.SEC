<BRK/>
<SPT><TTL>Motor Control Centers</TTL><BRK/>
<BRK/>
<TXT><RID>NEMA ICS 1</RID>.</TXT><BRK/>
<BRK/>
<TXT><RID>NEMA ICS 2</RID>.</TXT><BRK/>
<BRK/></SPT>
<SPT><TTL>Switchboards</TTL><BRK/>
<BRK/>
<TXT><RID>NEMA PB 1</RID>.</TXT><BRK/>
<BRK/></SPT>
