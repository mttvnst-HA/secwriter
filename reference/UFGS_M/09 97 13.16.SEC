         </CEL>
         <CEL>
<DTA TYPE="STRING">60-70</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING">71-80</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING">81-90</DTA>
         </CEL>
         <CEL>
