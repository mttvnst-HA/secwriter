      <STY SID="s50">
         <ALN HORIZONTAL="CENTER"/>
      </STY>
   </STS>
   <TDA COLUMNCOUNT="7" ROWCOUNT="3">
      <COL AUTOWIDTH="0" WIDTH="136.50"/>
      <COL AUTOWIDTH="0" WIDTH="42.00"/>
      <COL AUTOWIDTH="0" WIDTH="45.75"/>
      <COL AUTOWIDTH="0" WIDTH="40.50"/>
      <COL AUTOWIDTH="0" WIDTH="45.00"/>
      <COL AUTOWIDTH="0" WIDTH="45.75"/>
