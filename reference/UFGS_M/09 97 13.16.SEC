<DTA TYPE="STRING">RECOAT WINDOW (Hrs.)</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING">24-72</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING">18-60</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING">16-48</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING">12-36</DTA>
         </CEL>
         <CEL>
