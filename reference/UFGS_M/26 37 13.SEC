<TXT><TAB WIDTH="63">
<WBK>
   <STS>
      <STY SID="s50">
         <ALN VERTICAL="BOTTOM"/>
      </STY>
   </STS>
   <TDA COLUMNCOUNT="2" ROWCOUNT="34">
      <COL STYLEID="s50" AUTOWIDTH="0" WIDTH="65.25"/>
      <COL STYLEID="s50" AUTOWIDTH="0" WIDTH="222.00"/>
      <ROW AUTOHEIGHT="0" HEIGHT="23.25">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Acronym</DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Term</DTA>
