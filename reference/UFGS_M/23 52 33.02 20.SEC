<DTA TYPE="STRING">Minimum Size</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="24.00">
         <CEL>
<DTA TYPE="STRING">Thru setting</DTA>
         </CEL>
