<ITM>Convective:  [_____] sq.<MET> m</MET><ENG> ft.</ENG></ITM><BRK/>
<BRK/>
<OLI LEVEL="2">Furnace volume, minimum:  [_____] cu.<MET> m</MET><ENG> ft.</ENG></OLI><BRK/>
<BRK/>
<OLI LEVEL="2">Maximum boiler flue gas exit</OLI><BRK/>
<ITM>Temperature:  [_____] degrees<MET> C</MET><ENG> F</ENG></ITM><BRK/>
<ITM>Continuous rating:  [_____] degrees<MET> C</MET><ENG> F</ENG></ITM><BRK/>
<BRK/>
<OLI LEVEL="2">Maximum economizer flue gas exit</OLI><BRK/>
<ITM>Temperature:  [_____] degrees<MET> C</MET><ENG> F</ENG></ITM><BRK/>
