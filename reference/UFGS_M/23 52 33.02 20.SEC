<SPT><TTL>Stacks With Flue Gas Scrubbers</TTL><BRK/>
<BRK/>
<TXT>Stacks with flue gas scrubbers, boilers<MET> 5 kg/sec</MET><ENG> 40,000 lb/hour</ENG> and over:</TXT><BRK/>
<OLG><BRK/>
<OLI>Temperature</OLI><BRK/>
<BRK/>
<OLI LEVEL="2">Maximum ambient:  [_____] degrees<MET> C</MET><ENG> F</ENG></OLI><BRK/>
<BRK/>
<OLI LEVEL="2">Minimum ambient:  [_____] degrees<MET> C</MET><ENG> F</ENG></OLI><BRK/>
<BRK/>
<OLI LEVEL="2">Inlet gas at maximum gas flow (coal):  [_____] degrees<MET> C</MET><ENG> F</ENG></OLI><BRK/>
<BRK/>
<OLI LEVEL="2">Inlet gas at maximum gas flow (oil):  [_____] degrees<MET> C</MET><ENG> F</ENG></OLI><BRK/>
<BRK/>
<OLI LEVEL="2">Inlet gas at minimum gas flow (coal):  [_____] degrees<MET> C</MET><ENG> F</ENG></OLI><BRK/>
<BRK/>
<OLI LEVEL="2">Inlet gas at minimum gas flow (oil):  [_____] degrees<MET> C</MET><ENG> F</ENG></OLI><BRK/>
<BRK/>
<OLI>Gas Flow at Inlet</OLI><BRK/>
<BRK/>
<OLI LEVEL="2">Maximum:  [_____]<MET> kg/s</MET><ENG> lbs/hr</ENG></OLI><BRK/>
<BRK/>
<OLI LEVEL="2">Minimum:  [_____]<MET> kg/s</MET><ENG> lbs/hr</ENG></OLI><BRK/>
<BRK/>
<OLI>Required net available draft at stack inlet</OLI><BRK/>
<BRK/>
<LST>Maximum gas flow:  [_____]<MET> Pa</MET><ENG> inches water</ENG></LST><BRK/>
<BRK/>
<OLI>Gas exit velocity (cone exit)</OLI><BRK/>
<BRK/>
<LST>Maximum at maximum conditions:  [_____]<MET> m/s</MET><ENG> ft/sec</ENG></LST><BRK/>
<BRK/>
<OLI>Flue gas dew point</OLI><BRK/>
<BRK/>
<OLI LEVEL="2">Fuel oil:  [_____] degrees<MET> C</MET><ENG> F</ENG></OLI><BRK/>
<BRK/>
<OLI LEVEL="2">Fuel-coal:  [_____] degrees<MET> C</MET><ENG> F</ENG></OLI><BRK/>
<BRK/>
<OLI>Test pressures</OLI><BRK/>
<BRK/>
