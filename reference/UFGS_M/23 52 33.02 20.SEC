<BRK/>
<OLI LEVEL="2">Elevation above sea level:  [_____]<MET> meters</MET><ENG> feet</ENG></OLI><BRK/>
<BRK/>
<OLI LEVEL="2">Boiler room &amp; combustion air ambient:  [_____] degrees<MET> C</MET><ENG> F</ENG></OLI><BRK/>
<BRK/>
<OLI LEVEL="2">Maximum allowable total draft loss furnace, boiler, exit damper, and economizer outlet at continuous rating:  [_____]<MET> Pa</MET><ENG> inches 
of Water</ENG></OLI><BRK/>
<BRK/>
<OLI LEVEL="2">Steam drum, minimum diameter:  [_____]<MET> mm</MET><ENG> inches</ENG></OLI><BRK/>
<BRK/>
<OLI LEVEL="2">Mud drum, minimum diameter:  [_____]<MET> mm</MET><ENG> inches</ENG></OLI><BRK/>
<BRK/>
