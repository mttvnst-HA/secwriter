<DTA TYPE="STRING">Sludge Flow Rate</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING">[_____]<MET> m<SPS>3</SPS>/hr</MET><ENG> gpd</ENG></DTA>
         </CEL>
      </ROW>
