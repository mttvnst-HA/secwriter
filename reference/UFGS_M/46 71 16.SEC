<DTA TYPE="STRING">Maximum Weir Loading Rate</DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">[_____]<MET> m<SPS>3</SPS>/m<SPS>2</SPS>/day</MET><ENG> gpd/sq ft</ENG></DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="26.25">
