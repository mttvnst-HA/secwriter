         <CEL>
<DTA TYPE="STRING">MATERIAL</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING">SEALING SURFACE</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="23.25">
         <CEL>
<DTA TYPE="STRING">Cast Steel, <RID>ASME B16.5</RID> Class 150</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING">Raised Face</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="23.25">
         <CEL>
<DTA TYPE="STRING">Cast Stainless Steel, <RID>ASME B16.5</RID></DTA>
         </CEL>
         <CEL>
