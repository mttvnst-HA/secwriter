<BRK/>
<ITM><SUB>Frames</SUB>; <SUB>G<TAI OPT="ARMY">, [_____]</TAI></SUB></ITM><BRK/>
<BRK/>
<ITM><SUB>Recycled Content for Steel Frame Product</SUB>; <SUB>S</SUB></ITM><BRK/>
<BRK/>
