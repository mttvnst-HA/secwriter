         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="36.00">
         <CEL MERGEDOWN="1" STYLEID="s50">
<DTA TYPE="STRING"><HL1>Welded Joint type and pipe size, inches</HL1></DTA>
