<DTA TYPE="STRING">Measurement</DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Tolerance</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="19.50">
         <CEL>
<DTA TYPE="STRING">Grade</DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Plus/Minus<MET> 13 mm</MET><ENG> 1/2 inch</ENG></DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="19.50">
         <CEL>
<DTA TYPE="STRING">Smoothness</DTA>
         </CEL>
