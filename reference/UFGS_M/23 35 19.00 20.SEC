         </CEL>
         <CEL>
<DTA TYPE="STRING"><HL1>Type Starter</HL1></DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="24.00">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Up to 7 1/2</DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">208-230</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING">Across-the-line magnetic</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="36.00">
