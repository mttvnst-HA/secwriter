<DTA TYPE="STRING">9</DTA>
         </CEL>
         <CEL STYLEID="s52">
<DTA TYPE="STRING">M&amp;C software monitoring displays have been created for all building systems, including all override and display points indicated on Points Schedule drawings.</DTA>
         </CEL>
         <CEL STYLEID="s52"/>
         <CEL STYLEID="s51">
<DTA TYPE="STRING">|____|</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="34.50">
         <CEL STYLEID="s51">
<DTA TYPE="STRING">10</DTA>
         </CEL>
         <CEL STYLEID="s52">
<DTA TYPE="STRING">Final As-built Drawings accurately represent the final installed system.</DTA>
         </CEL>
