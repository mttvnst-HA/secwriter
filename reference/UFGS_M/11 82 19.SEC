<DTA TYPE="STRING">Capacity<MET> (grams per second)</MET><ENG> (pounds per hour)</ENG></DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Min. Refractory Thickness<MET> (mm)</MET><ENG> (inches)</ENG></DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="20.25">
         <CEL MERGEACROSS="1">
