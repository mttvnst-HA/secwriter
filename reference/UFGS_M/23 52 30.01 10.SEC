<BRL/><BRL/><BRL/><BRL/><BRL/><BRL/><BRL/><BRL/><BRL/><BRL/><BRL/></TAB><TAB>
<WBK>
   <STS>
      <STY SID="s50">
         <ALN HORIZONTAL="CENTER"/>
      </STY>
   </STS>
   <TDA COLUMNCOUNT="3" ROWCOUNT="5">
      <COL AUTOWIDTH="0" WIDTH="152.25"/>
      <COL AUTOWIDTH="0" WIDTH="152.25"/>
      <COL AUTOWIDTH="0" WIDTH="152.25"/>
      <ROW AUTOHEIGHT="0" HEIGHT="24.00">
         <CEL>
<DTA TYPE="STRING">Temperature</DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Indicator</DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Recorder Point</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="24.00">
         <CEL>
<DTA TYPE="STRING">Main steam</DTA>
         </CEL>
         <CEL STYLEID="s50"/>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">X</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="24.00">
         <CEL>
<DTA TYPE="STRING">Boiler gas outlet</DTA>
         </CEL>
         <CEL STYLEID="s50"/>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">X</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="24.00">
         <CEL>
<DTA TYPE="STRING">Windbox</DTA>
         </CEL>
         <CEL STYLEID="s50"/>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">X</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="23.25">
