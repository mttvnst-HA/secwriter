      <ROW AUTOHEIGHT="0" HEIGHT="36.00">
         <CEL>
<DTA TYPE="STRING">Water column (1)</DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING"><MET>0-4100</MET><ENG>0-600</ENG></DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING">Std weight black steel (2)</DTA>
