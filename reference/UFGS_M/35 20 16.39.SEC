<BRK/>
<ITM><SUB>Fracture Control Plan (FCP)</SUB>; <SUB>G<TAI OPT="ARMY">, [_____]</TAI></SUB></ITM><BRK/>
<BRK/>
<ITM><SUB>Handling Attachments and Pick Points</SUB>; <SUB>G<TAI OPT="ARMY">, [_____]</TAI></SUB></ITM><BRK/>
<BRK/>
