         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="24.00">
         <CEL STYLEID="s51">
<DTA TYPE="STRING">One-way</DTA>
         </CEL>
         <CEL STYLEID="s51">
<DTA TYPE="STRING">1</DTA>
         </CEL>
         <CEL STYLEID="s52">
<DTA TYPE="STRING">2</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="24.00">
         <CEL STYLEID="s51">
<DTA TYPE="STRING">acting with stirrups</DTA>
         </CEL>
