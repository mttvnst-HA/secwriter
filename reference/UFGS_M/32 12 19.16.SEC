<DTA TYPE="STRING">Sieve Size <MET></MET></DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Percent by Weight Passing</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="24.00">
