<DTA TYPE="STRING"><MET> 0.60 mm</MET><ENG> 
No. 30</ENG></DTA>
         </CEL>
         <CEL STYLEID="s51">
<DTA TYPE="STRING">95-100</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="23.25">
         <CEL STYLEID="s51">
<DTA TYPE="STRING"><MET> 0.075 mm</MET><ENG> No. 200</ENG></DTA>
