<DTA TYPE="STRING">Tensile Strength</DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING"><MET>17.2 MPa</MET><ENG>2500 psi</ENG> (min.)</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING"><RID>ASTM D412</RID></DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="24.00">
