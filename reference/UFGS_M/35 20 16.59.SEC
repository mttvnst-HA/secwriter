<DTA TYPE="STRING">Elongation at Break</DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">450 percent (min.)</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING"><RID>ASTM D412</RID></DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="24.00">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">300 percent Modules</DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING"><MET>6.2 MPa</MET><ENG>900 psi</ENG> (min.)</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING"><RID>ASTM D412</RID></DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="24.00">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Durometer Hardness (Shore Type A)</DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">60 to 70</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING"><RID>ASTM D2240</RID></DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="24.00">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Water Absorption</DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">5 percent by weight (max.)</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING"><RID>ASTM D471</RID></DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="24.00">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Compression Set</DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">30 percent (max.)</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING"><RID>ASTM D395</RID></DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="35.25">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Tensile Strength (after aging 48 hrs.)</DTA>
         </CEL>
