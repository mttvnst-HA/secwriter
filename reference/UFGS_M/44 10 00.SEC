<DTA TYPE="STRING">[_____]<MET> mg per actual cubic meters</MET><ENG> grains/acf</ENG></DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="22.50">
         <CEL INDEX="2">
<DTA TYPE="STRING">[_____]<MET> mg per standard cubic meter</MET><ENG> grains/scf</ENG></DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="22.50">
         <CEL INDEX="2">
<DTA TYPE="STRING">[_____]<MET> nanograms per J</MET><ENG> pounds/10<SPS>6</SPS> Btu</ENG></DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="22.50">
         <CEL>
<DTA TYPE="STRING">Allowable Collector Pressure Drop:</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING">[_____]<MET> Pa</MET><ENG> inches</ENG> water gauge Inlet Flange to Outlet Flange</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="22.50">
         <CEL MERGEACROSS="1">
<DTA TYPE="STRING">Collector Internal Pressure Relative to Atmosphere</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="22.50">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Positive</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING">[_____]<MET> Pa</MET><ENG> inches of water</ENG> gauge</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="22.50">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Negative</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING">[_____]<MET> Pa</MET><ENG> inches of water</ENG> gauge</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="22.50">
         <CEL MERGEACROSS="1">
<DTA TYPE="STRING">Water Supply:</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="22.50">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Pressure:</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING">[_____]<MET> kPa</MET><ENG> psig</ENG></DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="21.75">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Flow Rate:</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING">[_____]<MET> L/sec</MET><ENG> gpm</ENG></DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="99.00">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Water Analysis:</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING">[_____]</DTA>
         </CEL>
      </ROW>
   </TDA>
</WBK>
