<DTA TYPE="STRING">Temperature:</DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">[_____] degrees<MET> C</MET><ENG> F</ENG></DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="24.00">
