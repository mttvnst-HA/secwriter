         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="18.00">
         <CEL MERGEACROSS="1" STYLEID="s50">
<DTA TYPE="STRING">Surface Temperature Limitations of Underlying Course</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="18.00">
