         <CEL>
<DTA TYPE="STRING"><MET>16 mm</MET><ENG>5/8 inch</ENG></DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING"><MET>91 kN</MET><ENG>19 kips</ENG></DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="23.25">
         <CEL>
<DTA TYPE="STRING"><MET>20 mm</MET><ENG>3/4 inch</ENG></DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING"><MET>142 kN</MET><ENG>28 kips</ENG></DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="23.25">
