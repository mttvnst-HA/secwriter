      <COL STYLEID="s50" AUTOWIDTH="0" WIDTH="86.25"/>
      <COL AUTOWIDTH="0" WIDTH="86.25"/>
      <COL AUTOWIDTH="0" WIDTH="86.25"/>
      <COL AUTOWIDTH="0" WIDTH="111.75"/>
      <ROW AUTOHEIGHT="0" HEIGHT="17.25">
         <CEL MERGEACROSS="4" STYLEID="s51">
<DTA TYPE="STRING">RECORD OF DESIGNATED EQUIPMENT AND MATERIALS DATA</DTA>
