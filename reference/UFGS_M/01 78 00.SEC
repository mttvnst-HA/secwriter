         </CEL>
         <CEL>
<DTA TYPE="STRING">Manufacturer and Catalog, Model, and Serial Number</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING">Composition and Size</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING">Where Used</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="24.00">
         <CEL STYLEID="s50"/>
         <CEL STYLEID="s50"/>
         <CEL/>
         <CEL/>
         <CEL/>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="36.00">
         <CEL STYLEID="s50"/>
