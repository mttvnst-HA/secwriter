         <CEL MERGEACROSS="1" STYLEID="s50">
<DTA TYPE="STRING">Table 2</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="51.75">
         <CEL>
<DTA TYPE="STRING">Type of Soil Stabilized</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING">Maximum Allowable Weight Loss After 12 Wet-Dry or Freeze-Thaw Cycles, as a Percent of Initial Specimen Weight<BRK/></DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="33.00">
