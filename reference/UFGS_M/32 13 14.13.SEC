         <ALN HORIZONTAL="CENTER" VERTICAL="BOTTOM"/>
      </STY>
      <STY SID="s52">
         <ALN HORIZONTAL="RIGHT" VERTICAL="BOTTOM"/>
      </STY>
   </STS>
   <TDA COLUMNCOUNT="2" ROWCOUNT="7">
      <COL STYLEID="s50" AUTOWIDTH="0" WIDTH="330.00"/>
      <COL STYLEID="s50" AUTOWIDTH="0" WIDTH="126.75"/>
