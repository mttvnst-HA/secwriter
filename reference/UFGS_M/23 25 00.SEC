<DTA TYPE="STRING">Written evaluation summary</DTA>
         </CEL>
         <CEL/>
      </ROW>
   </TDA>
</WBK>
<BRL/><BRL/><BRL/><BRL/><BRL/><BRL/><BRL/><BRL/><BRL/><BRL/><BRL/><BRL/><BRL/><BRL/><BRL/><BRL/><BRL/>
<BRL/><BRL/><BRL/><BRL/><BRL/><BRL/><BRL/><BRL/><BRL/><BRL/></TAB></OLI><BRK/>
<BRK/>
<OLI>Large steam boilers are those operating above<MET> 100 kPa</MET><ENG> 15 psi</ENG> and<MET> 1 MW</MET><ENG> 100 hp</ENG>.  Retain an independent 
consultant to analyze the boiler water a minimum of once a month for a period of 1 year.  Include the 
following information recorded in accordance with <RID>ASTM D596</RID> in the monthly report.</OLI><BRK/>
<OLI><TAB HEADERROWS="0">
<WBK>
   <STS>
      <STY SID="s50">
         <ALN VERTICAL="BOTTOM"/>
      </STY>
   </STS>
   <TDA COLUMNCOUNT="2" ROWCOUNT="17">
      <COL STYLEID="s50" AUTOWIDTH="0" WIDTH="321.75"/>
      <COL STYLEID="s50" AUTOWIDTH="0" WIDTH="321.75"/>
      <ROW AUTOHEIGHT="0" HEIGHT="23.25">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Date of Sample</DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">[_____]</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="23.25">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">pH</DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">[_____]</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="23.25">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Sulfite (NaSO3)</DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">[_____] ppm (mg/L)</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="23.25">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">P Alkalinity (as CaCO3)</DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">[_____] ppm (mg/L)</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="23.25">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Conductivity</DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">[_____] micromho/cm</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="23.25">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Neutralized Conductivity</DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">[_____] micromho/cm</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="23.25">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Total Dissolved Solids</DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">[_____] ppm (mg/L)</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="23.25">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Phosphate (PO4)</DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">[_____] ppm (mg/L)</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="23.25">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Polymer, if used</DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">[_____] ppm (mg/L)</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="23.25">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Silica (SiO2)</DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">[_____] ppm (mg/L)</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="23.25">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Iron (total, as Fe(2)O(3))</DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">[_____] ppm (mg/L)</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="23.25">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Condensate pH</DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">[_____]</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="23.25">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Condensate Conductivity</DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">[_____] micromho/cm</DTA>
