      <ROW AUTOHEIGHT="0" HEIGHT="23.25">
         <CEL>
<DTA TYPE="STRING">Phosphate, if used, (PO4)</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING">[_____] ppm (mg/L)</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="23.25">
         <CEL>
<DTA TYPE="STRING">Polymer, if used</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING">[_____] ppm (mg/L)</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="23.25">
         <CEL>
<DTA TYPE="STRING">Iron (total, as Fe(2)O(3))</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING">[_____] ppm (mg/L)</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="23.25">
         <CEL>
<DTA TYPE="STRING">Condensate pH</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING">[_____]</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="23.25">
         <CEL>
<DTA TYPE="STRING">Condensate Conductivity</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING">[_____] micromho/cm</DTA>
