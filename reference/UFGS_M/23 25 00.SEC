      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="23.25">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Condensate Iron (total, as Fe(2)O(3))</DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">[_____] ppm (mg/L)</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="23.25">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Makeup Water Hardness (as CaCO3)</DTA>
