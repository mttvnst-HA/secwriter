<DTA TYPE="STRING"><MET>24 kg/cubic m</MET><ENG>1.5 lbs/ft</ENG></DTA>
         </CEL>
         <CEL STYLEID="s52">
<DTA TYPE="STRING"><MET>16 kg/cubic m</MET><ENG>1.0 lbs/ft</ENG></DTA>
