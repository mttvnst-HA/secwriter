<DTA TYPE="STRING">Water Content</DTA>
         </CEL>
         <CEL STYLEID="s52">
<DTA TYPE="STRING">1.5 percent</DTA>
         </CEL>
         <CEL STYLEID="s52">
<DTA TYPE="STRING">1.0 percent</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="30.00">
