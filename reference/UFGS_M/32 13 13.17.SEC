<DTA TYPE="STRING">Material</DTA>
         </CEL>
         <CEL STYLEID="s51">
<DTA TYPE="STRING">Tolerance, percent</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="15.00">
