         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="45.00">
         <CEL>
<DTA TYPE="STRING">Blended portland cement in combination with 25 percent or less coal ash or Slag Cement</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING"><CTR>14 days</CTR></DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="54.75">
         <CEL>
<DTA TYPE="STRING">Blended portland cement in combination with more than 25 percent coal ash or Slag Cement</DTA>
