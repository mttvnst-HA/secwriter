<DTA TYPE="STRING"><CTR><BRK/><BRK/>NOT exposed to weather or in contact with ground</CTR></DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING"><CTR>Slabs, joists, and walls</CTR></DTA>
