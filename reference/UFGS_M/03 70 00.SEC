         <CEL>
<DTA TYPE="STRING">Concrete Heat of Hydration</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING">Test Method For Heat Of Hydraulic Cement</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING">ASTM C186 and COE CRD-C 229</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="40.50">
         <CEL>
<DTA TYPE="STRING">Temperature Rise</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING">Temperature Rise Of Concrete</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING">USBR 4911 and COE CRD-C 38</DTA>
         </CEL>
      </ROW>
