         </CEL>
      </ROW>
   </TDA>
</WBK>
<BRL/><BRL/><BRL/><BRL/><BRL/><BRL/><BRL/><BRL/><BRL/><BRL/></TAB><TAB>
<WBK>
   <STS/>
   <TDA COLUMNCOUNT="2" ROWCOUNT="4">
      <COL AUTOWIDTH="0" WIDTH="228.75"/>
      <COL AUTOWIDTH="0" WIDTH="228.00"/>
      <ROW AUTOHEIGHT="0" HEIGHT="21.75">
         <CEL MERGEACROSS="1">
<DTA TYPE="STRING"><CTR>Blended Portland Cements in accordance with <RID>ASTM C595/C595M</RID></CTR></DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="21.75">
         <CEL>
<DTA TYPE="STRING">Blended portland cement Type IL</DTA>
         </CEL>
         <CEL>
