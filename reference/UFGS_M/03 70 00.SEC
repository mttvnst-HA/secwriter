         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="45.75">
         <CEL>
<DTA TYPE="STRING">Portland cement in combination with more than 25 percent coal ash or Slag Cement</DTA>
         </CEL>
