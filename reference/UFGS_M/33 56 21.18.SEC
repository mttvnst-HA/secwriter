<DTA TYPE="STRING">Grab Tensile, N (lbs)</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING">1110 min. (250)</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING"><RID>ASTM D4632/D4632M</RID></DTA>
         </CEL>
      </ROW>
