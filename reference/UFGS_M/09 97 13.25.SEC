         <CEL INDEX="4" MERGEACROSS="3" STYLEID="s50">
<DTA TYPE="STRING">Maximum time through a No. 4 Ford Cup</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="26.25">
         <CEL MERGEACROSS="2" STYLEID="s50">
<DTA TYPE="STRING">Initially</DTA>
         </CEL>
         <CEL INDEX="4" MERGEACROSS="3" STYLEID="s50">
<DTA TYPE="STRING">30 seconds</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="21.75">
         <CEL MERGEACROSS="2" STYLEID="s50">
<DTA TYPE="STRING">2 hours</DTA>
         </CEL>
         <CEL INDEX="4" MERGEACROSS="3" STYLEID="s50">
<DTA TYPE="STRING">60 seconds</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="24.00">
