         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING"><RID>ASTM D412</RID> (Die C)</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING"><MET>200 kPa</MET><ENG> 30 psi</ENG> max.</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="22.50">
