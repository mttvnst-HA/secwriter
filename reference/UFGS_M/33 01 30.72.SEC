<BRK/>
<HL4>MINIMUM PHYSICAL PROPERTIES</HL4><TAB>
<WBK>
   <STS/>
   <TDA COLUMNCOUNT="3" ROWCOUNT="3">
      <COL AUTOWIDTH="0" WIDTH="128.25"/>
      <COL AUTOWIDTH="0" WIDTH="128.25"/>
