         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="35.25">
         <CEL MERGEACROSS="1" STYLEID="s51">
<DTA TYPE="STRING">Note: When water or chemical admixtures are measured by volume, they must meet the same tolerance percent as stated in the chart.</DTA>
         </CEL>
      </ROW>
