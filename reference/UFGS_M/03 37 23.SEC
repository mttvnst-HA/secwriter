      </STY>
      <STY SID="s52">
         <ALN HORIZONTAL="CENTER"/>
      </STY>
   </STS>
   <TDA COLUMNCOUNT="4" ROWCOUNT="15">
      <COL STYLEID="s50" AUTOWIDTH="0" WIDTH="162.00"/>
      <COL STYLEID="s50" AUTOWIDTH="0" WIDTH="96.75"/>
      <COL AUTOWIDTH="0" WIDTH="96.75"/>
      <COL AUTOWIDTH="0" WIDTH="101.25"/>
      <ROW AUTOHEIGHT="0" HEIGHT="21.00">
         <CEL MERGEACROSS="3" STYLEID="s51">
<DTA TYPE="STRING">FREQUENCY</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="21.00">
         <CEL>
<DTA TYPE="STRING">PROPERTY</DTA>
         </CEL>
         <CEL STYLEID="s52">
<DTA TYPE="STRING">FINE AGGREGATE</DTA>
         </CEL>
         <CEL STYLEID="s52">
<DTA TYPE="STRING">COARSE AGGREGATE</DTA>
         </CEL>
         <CEL STYLEID="s52">
<DTA TYPE="STRING">TEST</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="33.00">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Specific Gravity</DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Every 3 months</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING">Every 3 months</DTA>
