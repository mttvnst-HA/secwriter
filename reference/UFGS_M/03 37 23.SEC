         <CEL STYLEID="s50">
<DTA TYPE="STRING">Aggregate smaller than<MET> 37.5 mm</MET><ENG> 1-1/2 inch</ENG> size</DTA>
         </CEL>
         <CEL STYLEID="s51">
<DTA TYPE="STRING">± 2 percent</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="21.00">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Aggregate larger than<MET> 37.5 mm</MET><ENG> 1-1/2 inch</ENG> size</DTA>
         </CEL>
         <CEL STYLEID="s51">
<DTA TYPE="STRING">± 3 percent</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="15.00">
