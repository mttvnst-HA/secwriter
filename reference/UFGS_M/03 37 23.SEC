         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="24.00">
         <CEL>
<DTA TYPE="STRING">Aggregate larger than<MET> 37.5 mm</MET><ENG> 1-1/2 inch</ENG> size</DTA>
         </CEL>
         <CEL STYLEID="s50">
