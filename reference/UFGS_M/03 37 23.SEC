         </CEL>
         <CEL STYLEID="s51">
<DTA TYPE="STRING">PERMISSIBLE LIMITS<BRK/>PERCENT BY MASS, PASSING</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="15.75">
