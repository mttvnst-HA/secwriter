</TAI><TAI OPT="SUPERPAVE GYRATORY COMPACTION"><OLI><TAB HEADERROWS="2">
<WBK>
   <STS/>
   <TDA COLUMNCOUNT="2" ROWCOUNT="11">
      <COL AUTOWIDTH="0" WIDTH="216.00"/>
      <COL AUTOWIDTH="0" WIDTH="216.00"/>
      <ROW AUTOHEIGHT="0" HEIGHT="33.00">
         <CEL MERGEACROSS="1">
