<DTA TYPE="STRING">TSR Conditioned Strength (minimum<MET> kPa</MET><ENG> psi</ENG>)</DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING"><HL4><MET>415</MET><ENG>60</ENG></HL4></DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="26.25">
         <CEL>
<DTA TYPE="STRING">Weight loss by fuel Immersion, maximum percent</DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING"><HL4>1.5<SPS>(5)</SPS></HL4></DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="29.25">
         <CEL MERGEACROSS="1">
<DTA TYPE="STRING">(1)  This is a minimum requirement.  Provide significantly higher average during construction to ensure compliance with the specifications.</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="24.00">
         <CEL MERGEACROSS="1">
<DTA TYPE="STRING">(2)  The flow requirement is not applicable for Polymer Modified Asphalts</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="41.25">
         <CEL MERGEACROSS="1">
<DTA TYPE="STRING">(3)  Dust Proportion is calculated as the aggregate content, expressed as a percent of mass, passing the<MET> 0.075 mm</MET><ENG> No. 200</ENG> sieve, divided by the effective asphalt content, in percent of total mass of the mixture.</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="41.25">
         <CEL MERGEACROSS="1">
<DTA TYPE="STRING">(4)  Select the JMF asphalt content corresponding to an air void content of 2.5 percent. Verify the other properties of Table 7 meet the specification requirements at this asphalt content.</DTA>
         </CEL>
      </ROW>
