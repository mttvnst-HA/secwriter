<DTA TYPE="STRING">Asphalt Binder</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="18.00">
         <CEL>
<DTA TYPE="STRING">All Grades</DTA>
         </CEL>
