<DTA TYPE="STRING">[<MET>75 mm</MET> <ENG>3 inch</ENG>][_____]</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING">[100][_____]</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="24.00">
