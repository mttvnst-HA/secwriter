         <CEL>
<DTA TYPE="STRING">Acceptance Coefficient, A</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING">Rejection Coefficient, B</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="22.50">
