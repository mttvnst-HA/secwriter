<DTA TYPE="STRING"><HL4>Table 1.  Statistical Acceptance and Rejection Coefficients</HL4></DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="58.50">
         <CEL>
<DTA TYPE="STRING">Number of Window Assemblies, n</DTA>
