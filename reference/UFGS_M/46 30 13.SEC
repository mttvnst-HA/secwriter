<DTA TYPE="STRING">Cooling water temperature rise at rated production capacity (maximum)</DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING"><MET>[3] [_____] degrees C</MET><ENG>[5] [_____] degrees F</ENG></DTA>
         </CEL>
