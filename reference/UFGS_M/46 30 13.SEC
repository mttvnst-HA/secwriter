<DTA TYPE="STRING">Max. ozone concentration into destruct unit</DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">[1.0] [_____] percent by weight</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="30.00">
