   <TDA COLUMNCOUNT="5" ROWCOUNT="18">
      <COL STYLEID="s50" AUTOWIDTH="0" WIDTH="93.75"/>
      <COL AUTOWIDTH="0" WIDTH="93.75"/>
      <COL AUTOWIDTH="0" WIDTH="93.75"/>
      <COL AUTOWIDTH="0" WIDTH="93.75"/>
      <COL AUTOWIDTH="0" WIDTH="93.00"/>
      <ROW AUTOHEIGHT="0" HEIGHT="30.75">
         <CEL MERGEACROSS="4" STYLEID="s51">
<DTA TYPE="STRING">TABLE 1<BRK/>MINIMUM PIPE INSULATION THICKNESS<MET> (mm)</MET><ENG> (Inches)</ENG></DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="36.75">
         <CEL MERGEACROSS="4" STYLEID="s51">
<DTA TYPE="STRING">For Steam<MET> (100 to 2,800 kPa (gage))</MET><ENG> (16 to 408 psig)</ENG> and High Temperature Hot Water Supply and Return<MET> (120 to 230 degrees C)</MET><ENG> (250 to 450 degrees F)</ENG></DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="30.75">
         <CEL STYLEID="s51"/>
         <CEL MERGEACROSS="1">
<DTA TYPE="STRING"><HL4>INSULATIONS for Drainable/Dryable Systems</HL4></DTA>
         </CEL>
         <CEL INDEX="4" MERGEACROSS="1" STYLEID="s52">
<DTA TYPE="STRING">INSULATIONS for Other Pre-Engineered Systems</DTA>
         </CEL>
      </ROW>
