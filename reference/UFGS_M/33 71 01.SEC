         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="24.00">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">AAC, AAAC, or ACSR (AWG</DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">AAAC OR AAC (AWG)</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="24.00">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Any size</DTA>
