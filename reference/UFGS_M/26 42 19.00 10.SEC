<BRL/><BRL/><BRL/><BRL/><BRL/><BRL/><BRL/><BRL/><BRL/><BRL/><BRL/><BRL/><BRL/></TAB></TXT><BRK/></SPT>
<SPT><TTL>Electrical Resistivity</TTL><BRK/>
<BRK/>
<TXT>Electrical Resistivity must be 72 micro-ohm-centimeter at<MET> -7 degrees C</MET><ENG> 20 degrees F</ENG> maximum.</TXT><BRK/>
<BRK/></SPT>
<SPT><TTL>Physical Properties (Nominal)</TTL><BRK/>
<TXT><TAB>
<WBK>
   <STS>
      <STY SID="s50">
         <ALN HORIZONTAL="CENTER"/>
      </STY>
   </STS>
   <TDA COLUMNCOUNT="2" ROWCOUNT="7">
      <COL AUTOWIDTH="0" WIDTH="228.00"/>
      <COL AUTOWIDTH="0" WIDTH="228.75"/>
      <ROW>
         <CEL>
<DTA TYPE="STRING">PROPERTY</DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">VALUE</DTA>
         </CEL>
      </ROW>
      <ROW>
         <CEL>
<DTA TYPE="STRING">Tensile Strength</DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING"><MET>1.05 kg/m<SPS>2</SPS></MET><ENG>15,000 psi</ENG></DTA>
         </CEL>
      </ROW>
      <ROW>
         <CEL>
<DTA TYPE="STRING">Compressive Strength</DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING"><MET>7.04 kg/m<SPS>2</SPS></MET><ENG>100,000 psi</ENG></DTA>
         </CEL>
      </ROW>
      <ROW>
         <CEL>
<DTA TYPE="STRING">Brinnell Hardness</DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">520</DTA>
         </CEL>
      </ROW>
