         <CEL>
<DTA TYPE="STRING">Within rated load driving pump at specified rpm</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="27.75">
         <CEL>
<DTA TYPE="STRING">Pump Control</DTA>
         </CEL>
