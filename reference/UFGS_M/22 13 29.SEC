<DTA TYPE="STRING">Total Dynamic Head</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING">[_____]<MET> mm</MET><ENG> feet</ENG></DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="24.00">
         <CEL>
<DTA TYPE="STRING">Suction and Discharge Check Valve Size</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING">[_____]<MET> mm</MET><ENG> inches</ENG></DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="24.00">
         <CEL>
<DTA TYPE="STRING">Pump Speed</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING">[_____] strokes per minute</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="24.00">
