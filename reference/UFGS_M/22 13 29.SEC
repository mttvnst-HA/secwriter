         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">[_____]<MET> L/second</MET><ENG> gpm</ENG> flow at [_____]<MET> mm</MET><ENG> feet</ENG> head</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="21.00">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Discharge Diameter</DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">[_____]<MET> mm</MET><ENG> feet</ENG></DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="21.00">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Suction Diameter</DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">[_____]<MET> mm</MET><ENG> feet</ENG></DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="21.00">
