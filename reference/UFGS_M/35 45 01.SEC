<DTA TYPE="STRING">DISCHARGE DIAMETER<MET> mm</MET><ENG> inch</ENG></DTA>
         </CEL>
         <CEL STYLEID="s51">
<DTA TYPE="STRING">MINIMUM NUMBER OF ANODES USED</DTA>
         </CEL>
         <CEL STYLEID="s51">
<DTA TYPE="STRING">TOTAL WEIGHT OF ANODES USED<MET> kg</MET><ENG> lbs</ENG></DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="21.00">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">From<MET> 500</MET><ENG> 20</ENG> up to and including<MET> 900</MET><ENG> 36</ENG></DTA>
         </CEL>
         <CEL STYLEID="s51">
<DTA TYPE="STRING">2</DTA>
         </CEL>
         <CEL STYLEID="s51">
<DTA TYPE="STRING"><MET>18</MET><ENG>40</ENG></DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="35.25">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Above<MET> 900</MET><ENG> 36</ENG> up to and including<MET> 1200</MET><ENG> 48</ENG></DTA>
         </CEL>
         <CEL STYLEID="s52">
<DTA TYPE="STRING">4</DTA>
         </CEL>
         <CEL STYLEID="s51">
<DTA TYPE="STRING"><MET>36</MET><ENG>80</ENG></DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="39.75">
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Above<MET> 1200</MET><ENG> 48</ENG> up to and including<MET> 2100</MET><ENG> 84</ENG></DTA>
         </CEL>
