      <ROW AUTOHEIGHT="0" HEIGHT="24.00">
         <CEL STYLEID="s51">
<DTA TYPE="STRING">DISCHARGE DIAMETER<BRK/><MET>mm</MET><ENG>inch</ENG></DTA>
         </CEL>
         <CEL STYLEID="s51">
