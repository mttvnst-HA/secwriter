         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="15.00">
         <CEL>
<DTA TYPE="STRING">Up to and including<MET> 600</MET><ENG> 24</ENG></DTA>
         </CEL>
         <CEL STYLEID="s50">
