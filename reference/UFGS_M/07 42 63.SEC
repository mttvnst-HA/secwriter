<DTA TYPE="STRING">Weatherometer:</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING"><RID>ASTM G152</RID>, <RID>ASTM G153</RID> and <RID>ASTM D822/D822M</RID></DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="23.25">
         <CEL>
<DTA TYPE="STRING">Humidity:</DTA>
         </CEL>
         <CEL>
