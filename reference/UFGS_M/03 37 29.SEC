<DTA TYPE="STRING">Absorption</DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Every 3 months</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING">Every 3 months</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING"><RID>ASTM C127</RID><BRK/><RID>ASTM C128</RID></DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="24.00">
