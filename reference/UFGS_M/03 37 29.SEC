<DTA TYPE="STRING">Clay Lumps and Friable Particles</DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Every 3 months</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING">Every 3 months</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING"><RID>ASTM C142/C142M</RID></DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="36.00">
