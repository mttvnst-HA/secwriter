<DTA TYPE="STRING">Material Finer than the <MET>75 µm </MET><ENG>No. 200 </ENG>Sieve</DTA>
         </CEL>
         <CEL STYLEID="s50">
<DTA TYPE="STRING">Every 3 months</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING">Every 3 months</DTA>
         </CEL>
         <CEL>
<DTA TYPE="STRING"><RID>ASTM C117</RID></DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="41.25">
