         <CEL MERGEACROSS="1" STYLEID="s51">
<DTA TYPE="STRING">TABLE 2 - WATER DISPOSAL/DISCHARGE CRITERIA</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="31.50">
         <CEL STYLEID="s51">
<DTA TYPE="STRING">PARAMETER</DTA>
         </CEL>
         <CEL STYLEID="s51">
<DTA TYPE="STRING">MAXIMUM CONCENTRATION</DTA>
         </CEL>
      </ROW>
      <ROW AUTOHEIGHT="0" HEIGHT="22.50">
